<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BotAimImprover</RootNamespace>
    <AssemblyName>BotAimImprover</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371" />
    <Reference Include="RayTraceApi">
      <HintPath>$(RayTraceApiPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRayTraceApiPath" BeforeTargets="ResolveReferences"
          Condition="'$(RayTraceApiPath)' == '' or !Exists('$(RayTraceApiPath)')">
    <Error Text="RayTraceApiPath must point to the verified RayTrace 1.0.16 RayTraceApi.dll." />
  </Target>

</Project>
